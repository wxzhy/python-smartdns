{
  "runtime": {
    "plugin_dirs": [
      "plugins"
    ],
    "loop_policy": "auto",
    "default_upstream_group": "default",
    "log_level": "INFO"
  },
  "tree_root": {
    "domain_dir": "examples/tags/domains",
    "ip_dir": "examples/tags/ips"
  },
  "listeners": [
    {
      "name": "udp-default",
      "protocol": "udp",
      "host": "127.0.0.1",
      "port": 5300,
      "enabled": true
    },
    {
      "name": "tcp-default",
      "protocol": "tcp",
      "host": "127.0.0.1",
      "port": 5300,
      "enabled": true
    }
  ],
  "nameservers": [
    {
      "name": "cf-udp",
      "protocol": "do53",
      "address": "1.1.1.1",
      "port": 53
    },
    {
      "name": "google-udp",
      "protocol": "do53",
      "address": "8.8.8.8",
      "port": 53
    },
    {
      "name": "quad9-dot",
      "protocol": "dot",
      "address": "9.9.9.9",
      "port": 853,
      "hostname": "dns.quad9.net",
      "verify": true
    },
    {
      "name": "cloudflare-doh",
      "protocol": "doh",
      "url": "https://cloudflare-dns.com/dns-query",
      "bootstrap_address": "1.1.1.1",
      "verify": true,
      "want_get": false,
      "http_version": "h2"
    },
    {
      "name": "adguard-doq",
      "protocol": "doq",
      "address": "94.140.14.14",
      "port": 853,
      "server_hostname": "unfiltered.adguard-dns.com",
      "verify": true
    }
  ],
  "upstreams": [
    {
      "name": "public-pool",
      "nameservers": [
        "cf-udp",
        "google-udp",
        "quad9-dot"
      ],
      "timeout": 1.0,
      "lifetime": 3.0,
      "use_tcp": false,
      "ecs": null
    },
    {
      "name": "encrypted-pool",
      "nameservers": [
        "cloudflare-doh",
        "adguard-doq"
      ],
      "timeout": 1.0,
      "lifetime": 3.0,
      "use_tcp": false,
      "ecs": "198.51.100.0/24"
    }
  ],
  "groups": [
    {
      "name": "default",
      "strategy": "race",
      "upstreams": [
        "public-pool",
        "encrypted-pool"
      ]
    },
    {
      "name": "all-address-wait",
      "strategy": "wait_all",
      "upstreams": [
        "public-pool",
        "encrypted-pool"
      ]
    }
  ],
  "rules": [
    {
      "name": "example-org-addresses",
      "enabled": true,
      "match": {
        "exact_domains": [],
        "suffix_domains": [
          "example.org"
        ],
        "qtypes": [
          "A",
          "AAAA"
        ]
      },
      "action": {
        "upstream_group": "default",
        "dispatcher": "wait_all"
      }
    },
    {
      "name": "corp-encrypted",
      "enabled": false,
      "match": {
        "exact_domains": [],
        "suffix_domains": [
          "corp.internal"
        ],
        "qtypes": [],
        "tags": []
      },
      "action": {
        "upstream_group": "default",
        "dispatcher": "race"
      }
    },
    {
      "name": "tagged-addresses",
      "enabled": false,
      "match": {
        "exact_domains": [],
        "suffix_domains": [],
        "qtypes": [
          "A",
          "AAAA"
        ],
        "tags": [
          "proxy"
        ]
      },
      "action": {
        "upstream_group": "default",
        "dispatcher": "race"
      }
    }
  ],
  "plugins": [
    {
      "name": "sample",
      "module": "sample_plugin",
      "enabled": false,
      "config": {
        "domains": [
          "sample.internal"
        ],
        "answer_name": "sample.static_a"
      },
      "variables": {
        "address": "127.0.0.1",
        "ttl": 30
      }
    },
    {
      "name": "cache",
      "module": "cache_plugin",
      "enabled": true,
      "config": {
        "max_size": 100000
      },
      "variables": {}
    },
    {
      "name": "speedtest",
      "module": "speedtest_plugin",
      "enabled": false,
      "config": {
        "cache_ttl_seconds": 900,
        "cache_maxsize": 4096,
        "max_concurrency": 64,
        "probe_timeout": 1.5,
        "ping_count": 1,
        "ping_privileged": false,
        "response_ip_limit": 2
      },
      "variables": {}
    },
    {
      "name": "ip_replace",
      "module": "ip_replace_plugin",
      "enabled": false,
      "config": {
        "skip_tags": [
          "direct",
          "local"
        ],
        "rules": [
          {
            "name": "proxy-map",
            "enabled": true,
            "match_tags": [
              "proxy"
            ],
            "exclude_tags": [
              "direct"
            ],
            "ipv4_targets": [
              "10.10.0.0/24",
              "10.20.0.0/24"
            ],
            "ipv6_targets": [
              "fd10:10::/64",
              "fd10:20::/64"
            ]
          }
        ]
      },
      "variables": {}
    },
    {
      "name": "tags",
      "module": "tag_plugin",
      "enabled": false,
      "config": {},
      "variables": {}
    }
  ],
  "webui": {
    "enabled": true,
    "doh_enabled": true,
    "host": "127.0.0.1",
    "port": 8080,
    "username": "admin",
    "password": "change-me"
  }
}
