{
  "runtime": {
    "plugin_dirs": [
      "plugins"
    ],
    "loop_policy": "auto",
    "default_upstream_group": "default",
    "default_upstream_policy": "race",
    "bootstrap_resolver": [
      "1.1.1.1",
      "8.8.8.8"
    ],
    "hosts": {
      "cloudflare-dns.com": [
        "1.1.1.1",
        "1.0.0.1"
      ]
    },
    "fingerprint": "chrome",
    "log_level": "INFO",
    "multiprocess": {
      "workers": "auto",
      "start_method": "auto",
      "queue_size": 1024,
      "response_timeout": 10.0,
      "front_cache_size": 100000
    }
  },
  "tree_root": {
    "domain_dir": "examples/tags/domains",
    "ip_dir": "examples/tags/ips"
  },
  "listeners": [
    {
      "name": "udp-default",
      "protocol": "udp",
      "host": "127.0.0.1",
      "port": 5300,
      "enabled": true
    },
    {
      "name": "tcp-default",
      "protocol": "tcp",
      "host": "127.0.0.1",
      "port": 5300,
      "enabled": true
    }
  ],
  "nameservers": [
    {
      "name": "cf-udp",
      "protocol": "do53",
      "address": "1.1.1.1",
      "port": 53
    },
    {
      "name": "cf-udp-custom",
      "protocol": "do53_custom",
      "address": "1.0.0.1",
      "port": 53,
      "use_tricks": true
    },
    {
      "name": "google-udp",
      "protocol": "do53",
      "address": "8.8.8.8",
      "port": 53
    },
    {
      "name": "cf-aiodns",
      "protocol": "aiodns",
      "servers": [
        "1.1.1.1",
        "1.0.0.1"
      ],
      "port": 53,
      "tcp": false,
      "timeout": 1.0
    },
    {
      "name": "quad9-dot",
      "protocol": "dot",
      "address": "9.9.9.9",
      "port": 853,
      "hostname": "dns.quad9.net",
      "verify": true
    },
    {
      "name": "cloudflare-doh",
      "protocol": "doh",
      "url": "https://cloudflare-dns.com/dns-query",
      "bootstrap_address": "1.1.1.1",
      "verify": true,
      "want_get": false,
      "http_version": "h2"
    },
    {
      "name": "cloudflare-doh-custom",
      "protocol": "doh_custom",
      "url": "https://cloudflare-dns.com/dns-query",
      "verify": true,
      "want_get": false,
      "http_version": "h2"
    },
    {
      "name": "cloudflare-doh-httpx-example",
      "protocol": "httpx",
      "url": "https://1.1.1.1/dns-query",
      "verify": true,
      "want_get": false,
      "http_version": "h2",
      "http_host": "cloudflare-dns.com",
      "server_hostname": "cloudflare-dns.com"
    },
    {
      "name": "cloudflare-doh-aiohttp-example",
      "protocol": "aiohttp",
      "url": "https://cloudflare-dns.com/dns-query",
      "verify": true,
      "want_get": false,
      "http_version": "h1",
      "http_host": "cloudflare-dns.com",
      "server_hostname": "cloudflare-dns.com"
    },
    {
      "name": "cloudflare-doh-curl-cffi-example",
      "protocol": "curl",
      "url": "https://cloudflare-dns.com/dns-query",
      "verify": true,
      "want_get": true,
      "http_version": "h3",
      "http_host": null
    },
    {
      "name": "adguard-doq",
      "protocol": "doq",
      "address": "94.140.14.14",
      "port": 853,
      "server_hostname": "unfiltered.adguard-dns.com",
      "verify": true
    },
    {
      "name": "opendns-dnscrypt",
      "protocol": "dnscrypt",
      "address": "208.67.220.220",
      "port": 443,
      "provider_name": "2.dnscrypt-cert.opendns.com",
      "provider_pk": "B735:1140:206F:225D:3E2B:D822:D7FD:691E:A1C3:3CC8:D666:8D0C:BE04:BFAB:CA43:FB79"
    }
  ],
  "upstreams": [
    {
      "name": "public-pool",
      "nameservers": [
        "cf-udp",
        "cf-udp-custom",
        "google-udp",
        "cf-aiodns",
        "quad9-dot"
      ],
      "timeout": 1.0,
      "lifetime": 3.0,
      "use_tcp": false,
      "ecs": null
    },
    {
      "name": "encrypted-pool",
      "nameservers": [
        "cloudflare-doh",
        "cloudflare-doh-custom",
        "adguard-doq",
        "opendns-dnscrypt"
      ],
      "timeout": 1.0,
      "lifetime": 3.0,
      "use_tcp": false,
      "ecs": "198.51.100.0/24"
    }
  ],
  "groups": [
    {
      "name": "default",
      "upstreams": [
        "public-pool",
        "encrypted-pool"
      ]
    },
    {
      "name": "all-address-wait",
      "upstreams": [
        "public-pool",
        "encrypted-pool"
      ]
    }
  ],
  "rules": [
    {
      "name": "example-org-addresses",
      "enabled": true,
      "match": {
        "match_tags": [
          "example-org"
        ],
        "exclude_tags": [],
        "qtypes": [
          "A",
          "AAAA"
        ]
      },
      "action": {
        "upstream_group": "default",
        "dispatcher": "wait_all"
      }
    },
    {
      "name": "corp-encrypted",
      "enabled": false,
      "match": {
        "match_tags": [
          "corp"
        ],
        "exclude_tags": [
          "direct"
        ],
        "qtypes": [
          "HTTPS"
        ]
      },
      "action": {
        "upstream_group": "default",
        "dispatcher": "race"
      }
    },
    {
      "name": "tagged-addresses",
      "enabled": false,
      "match": {
        "match_tags": [
          "proxy"
        ],
        "exclude_tags": [
          "direct"
        ],
        "qtypes": [
          "A",
          "AAAA"
        ]
      },
      "action": {
        "upstream_group": "default",
        "dispatcher": "race"
      }
    }
  ],
  "plugins": [
    {
      "name": "sample",
      "module": "sample_plugin",
      "enabled": false,
      "config": {
        "domains": [
          "sample.internal"
        ],
        "answer_name": "sample.static_a"
      },
      "variables": {
        "address": "127.0.0.1",
        "ttl": 30
      }
    },
    {
      "name": "redirect",
      "module": "redirect_plugin",
      "enabled": false,
      "config": {
        "redirects": {
          "www.example.com": "edge.example.net"
        }
      },
      "variables": {}
    },
    {
      "name": "cache",
      "module": "cache_plugin",
      "enabled": true,
      "config": {
        "max_size": 100000
      },
      "variables": {}
    },
    {
      "name": "query-log",
      "module": "query_log_plugin",
      "enabled": true,
      "config": {
        "max_entries": 500
      },
      "variables": {}
    },
    {
      "name": "speedtest",
      "module": "speedtest_plugin",
      "enabled": false,
      "config": {
        "cache_ttl_seconds": 900,
        "cache_maxsize": 4096,
        "max_concurrency": 64,
        "probe_timeout": 1.5,
        "ping_count": 1,
        "ping_privileged": false,
        "response_ip_limit": 2,
        "response_ttl_seconds": 600,
        "rtt_gap_threshold_ms": 20.0,
        "skip_tags": [
          "direct",
          "local"
        ],
        "fallback_rules": [
          {
            "match_tags": [
              "proxy"
            ],
            "exclude_tags": [
              "direct"
            ],
            "ipv4_addresses": [
              "10.10.0.2",
              "10.10.0.3"
            ],
            "ipv6_addresses": [
              "fd10:10::2",
              "fd10:10::3"
            ]
          }
        ]
      },
      "variables": {}
    },
    {
      "name": "block",
      "module": "block_plugin",
      "enabled": false,
      "config": {
        "rules": [
          {
            "match_tags": [
              "blackhole"
            ],
            "exclude_tags": [
              "direct"
            ],
            "ipv4_addresses": [
              "127.0.0.1"
            ],
            "ipv6_addresses": [
              "::1"
            ],
            "block_other": false,
            "response_ttl_seconds": 86400
          }
        ]
      },
      "variables": {}
    },
    {
      "name": "ip_replace",
      "module": "ip_replace_plugin",
      "enabled": false,
      "config": {
        "skip_tags": [
          "direct",
          "local"
        ],
        "rules": [
          {
            "name": "proxy-map",
            "match_tags": [
              "proxy"
            ],
            "exclude_tags": [
              "direct"
            ],
            "ipv4_targets": [
              "10.10.0.0/24",
              "10.20.0.0/24"
            ],
            "ipv6_targets": [
              "fd10:10::/64",
              "fd10:20::/64"
            ]
          }
        ]
      },
      "variables": {}
    },
    {
      "name": "ip_filter",
      "module": "ip_filter_plugin",
      "enabled": false,
      "config": {
        "match_tags": [
          "proxy"
        ],
        "exclude_tags": [
          "direct"
        ],
        "whitelist_tags": [],
        "blacklist_tags": [
          "blocked"
        ]
      },
      "variables": {}
    },
    {
      "name": "tags",
      "module": "tag_plugin",
      "enabled": false,
      "config": {},
      "variables": {}
    },
    {
      "name": "cloudflare-ech",
      "module": "cloudflare_ech_plugin",
      "enabled": false,
      "config": {
        "match_tags": [
          "cloudflare"
        ],
        "exclude_tags": [],
        "skip_tags": []
      },
      "variables": {}
    },
    {
      "name": "https-sanitize",
      "module": "https_plugin",
      "enabled": false,
      "config": {},
      "variables": {}
    }
  ],
  "webui": {
    "enabled": true,
    "doh_enabled": true,
    "host": "127.0.0.1",
    "port": 8080,
    "username": "admin",
    "password": "change-me"
  }
}
