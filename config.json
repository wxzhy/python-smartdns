    {
      "name": "v-ecs",
      "protocol": "doh_custom",
      "url": "https://v.recipes/dns-ecs"
    },
    {
      "name": "hinet-a",
      "protocol": "doh_custom",
      "url": "https://[2001:b000:168::1]/dns-query"
    },
    {
      "name": "hinet-b",
      "protocol": "doh_custom",
      "url": "https://[2001:b000:168::2]/dns-query"
    },
    {
      "name": "hinet-c",
      "protocol": "doh_custom",
      "url": "https://168.95.192.1/dns-query"
    },
    {
      "name": "hinet-d",
      "protocol": "doh_custom",
      "url": "https://168.95.1.1/dns-query"
    },
    {
      "name": "iij-a",
      "protocol": "doh_custom",
      "url": "https://[2001:300::5]/dns-query"
    },
    {
      "name": "iij-b",
      "protocol": "doh_custom",
      "url": "https://[2001:300::6]/dns-query"
    },
    {
      "name": "iij-c",
      "protocol": "doh_custom",
      "url": "https://103.2.57.5/dns-query"
    },
    {
      "name": "iij-d",
      "protocol": "doh_custom",
      "url": "https://103.2.57.6/dns-query"
    },
    {
      "name": "stub",
      "protocol": "do53",
      "address": "1.1.1.1"
    }
  ],
  "upstreams": [
    {
      "name": "cf",
      "nameservers": [
        "cf"
      ]
    },
    {
      "name": "114dns",
      "nameservers": [
        "114dns-a",
        "114dns-b"
      ]
    },
    {
      "name": "alidns",
      "nameservers": [
        "alidns-a",
        "alidns-b",
        "alidns-c",
        "alidns-d"
      ]
    },
    {
      "name": "dnspod",
      "nameservers": [
        "dnspod-a",
        "dnspod-b"
      ]
    },
    {
      "name": "google-v4",
      "nameservers": [
        "google-a",
        "google-b"
      ],
      "use_tcp": true
    },
    {
      "name": "google-v6",
      "nameservers": [
        "google-c",
        "google-d",
        "google-e"
      ],
      "use_tcp": true
    },
    {
      "name": "v-opt",
      "nameservers": [
        "v-opt"
      ]
    },
    {
      "name": "v-ecs",
      "nameservers": [
        "v-ecs"
      ]
    },
    {
      "name": "hinet",
      "nameservers": [
        "hinet-a",
        "hinet-b",
        "hinet-c",
        "hinet-d"
      ]
    },
    {
      "name": "iij",
      "nameservers": [
        "iij-a",
        "iij-b",
        "iij-c",
        "iij-d"
      ]
    },
    {
      "name": "stub",
      "nameservers": [
        "stub"
      ]
    }
  ],
  "groups": [
    {
      "name": "default",
      "upstreams": [
        "114dns",
        "alidns",
        "dnspod",
        "google-v4",
        "google-v6",
        "cf",
        "v-opt",
        "v-ecs",
        "hinet",
        "iij",
        "stub"
      ]
    },
    {
      "name": "cn",
      "upstreams": [
        "114dns",
        "alidns",
        "dnspod"
      ]
    },
    {
      "name": "global",
      "upstreams": [
        "google-v4",
        "google-v6",
        "cf",
        "v-opt",
        "v-ecs",
        "hinet",
        "iij",
        "stub"
      ]
    }
  ],
  "rules": [
    {
      "name": "cn",
      "enabled": true,
      "match": {
        "match_tags": [
          "cn",
          "google-cn"
        ],
        "exclude_tags": []
      },
      "action": {
        "upstream_group": "cn",
        "dispatcher": "wait_all"
      }
    },
    {
      "name": "global",
      "enabled": true,
      "match": {
        "match_tags": [
          "gfw",
          "google"
        ],
        "exclude_tags": [
          "cn"
        ]
      },
      "action": {
        "upstream_group": "global",
        "dispatcher": "wait_all"
      }
    },
    {
      "name": "all",
      "enabled": true,
      "match": {
        "qtypes": [
          "A",
          "AAAA"
        ]
      },
      "action": {
        "upstream_group": "default",
        "dispatcher": "wait_all"
      }
    }
  ],
  "plugins": [
    {
      "name": "sample",
      "module": "sample_plugin",
      "enabled": false,
      "config": {
        "domains": [
          "sample.internal"
        ],
        "answer_name": "sample.static_a"
      },
      "variables": {
        "address": "127.0.0.1",
        "ttl": 30
      }
    },
    {
      "name": "cache_plugin",
      "module": "cache_plugin",
      "enabled": true,
      "config": {
        "max_size": 100000
      },
      "variables": {}
    },
    {
      "name": "speedtest_plugin",
      "module": "speedtest_plugin",
      "enabled": true,
      "config": {
        "cache_ttl_seconds": 900,
        "cache_maxsize": 4096,
        "max_concurrency": 64,
        "probe_timeout": 0.5,
        "ping_count": 1,
        "ping_privileged": false,
        "response_ip_limit": 2,
        "response_ttl_seconds": 300,
        "skip_tags": [],
        "fallback_rules": [
          {
            "match_tags": [
              "google"
            ],
            "exclude_tags": [
              "cn",
              "ads"
            ],
            "ipv4_addresses": [
              "9.0.0.0"
            ],
            "ipv6_addresses": [
              "2620::"
            ]
          }
        ]
      },
      "variables": {}
    },
    {
      "name": "block_plugin",
      "module": "block_plugin",
      "enabled": true,
      "config": {
        "rules": [
          {
            "match_tags": [
              "ads"
            ],
            "exclude_tags": [],
            "ipv4_addresses": [
              "127.0.0.1"
            ],
            "ipv6_addresses": [
              "::1"
            ],
            "block_other": false,
            "response_ttl_seconds": 86400
          }
        ]
      },
      "variables": {}
    },
    {
      "name": "tag_plugin",
      "module": "tag_plugin",
      "enabled": true,
      "config": {},
      "variables": {}
    },
    {
      "name": "cloudflare_ech_plugin",
      "module": "cloudflare_ech_plugin",
      "enabled": true,
      "config": {
        "match_tags": [
          "cloudflare"
        ],
        "exclude_tags": [
          "cn",
          "ads"
        ],
        "skip_tags": [
          "cn",
          "ads",
          "private",
          "ntp",
          "google"
        ]
      },
      "variables": {}
    },
    {
      "name": "https_plugin",
      "module": "https_plugin",
      "enabled": true,
      "config": {},
      "variables": {}
    },
    {
      "name": "ip_replace_plugin",
      "module": "ip_replace_plugin",
      "enabled": true,
      "config": {
        "skip_tags": [
          "cn",
          "ads",
          "private",
          "ntp",
          "google"
        ],
        "rules": [
          {
            "name": "cloudflare",
            "match_tags": [
              "cloudflare"
            ],
            "exclude_tags": [],
            "ipv4_targets": [
              "162.159.44.0/32",
              "162.159.45.0/32"
            ],
            "ipv6_targets": [
              "2606:4700:52::/128",
              "2606:4700:57::/128"
            ]
          },
          {
            "name": "fastly",
            "match_tags": [
              "fastly"
            ],
            "exclude_tags": [],
            "ipv4_targets": [
              "146.75.48.0/22"
            ],
            "ipv6_targets": [
              "2a04:4e42:7c::/64"
            ]
          }
        ]
      },
      "variables": {}
    },
    {
      "name": "cloudflare-ech",
      "module": "cloudflare_ech_plugin",
      "enabled": true,
      "config": {
        "match_tags": [
          "cloudflare"
        ],
        "exclude_tags": [
          "cn",
          "ads",
          "private",
          "ntp",
          "google"
        ],
        "skip_tags": [
          "cn",
          "ads",
          "private",
          "ntp",
          "google"
        ]
      },
      "variables": {}
    },
    {
      "name": "https-sanitize",
      "module": "https_plugin",
      "enabled": true,
      "config": {},
      "variables": {}
    },
    {
      "name": "query-log",
      "module": "query_log_plugin",
      "enabled": true,
      "config": {
        "max_entries": 500
      },
      "variables": {}
    }
  ],
  "webui": {
    "enabled": true,
    "doh_enabled": true,
    "host": "127.0.0.1",
    "port": 8080,
    "username": "admin",
    "password": "admin"
  }
}