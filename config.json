{
  "runtime": {
    "plugin_dirs": [
      "plugins"
    ],
    "loop_policy": "auto",
    "default_upstream_group": "default",
    "log_level": "DEBUG"
  },
  "tree_root": {
    "domain_dir": "tags/geosite",
    "ip_dir": "tags/geoip"
  },
  "listeners": [
    {
      "name": "udp-default",
      "protocol": "udp",
      "host": "127.0.0.1",
      "port": 5300,
      "enabled": true
    },
    {
      "name": "tcp-default",
      "protocol": "tcp",
      "host": "127.0.0.1",
      "port": 5300,
      "enabled": true
    }
  ],
  "nameservers": [
    {
      "name": "cloudflare-primary",
      "protocol": "do53_custom",
      "address": "1.0.0.1",
      "port": 53
    },
    {
      "name": "google-backup",
      "protocol": "do53_custom",
      "address": "8.8.8.8",
      "port": 53
    }
  ],
  "upstreams": [
    {
      "name": "public-default",
      "nameservers": [
        "cloudflare-primary",
        "google-backup"
      ],
      "timeout": 2.0,
      "lifetime": 4.0,
      "use_tcp": true,
      "ecs": null
    }
  ],
  "groups": [
    {
      "name": "default",
      "strategy": "race",
      "upstreams": [
        "public-default"
      ]
    }
  ],
  "rules": [
    {
      "name": "sample-static",
      "enabled": false,
      "match": {
        "exact_domains": [
          "sample.internal"
        ],
        "suffix_domains": [],
        "qtypes": [
          "A"
        ],
        "tags": []
      },
      "action": {
        "upstream_group": "default"
      }
    }
  ],
  "plugins": [
    {
      "name": "sample",
      "module": "sample_plugin",
      "enabled": false,
      "config": {
        "domains": [
          "sample.internal"
        ],
        "answer_name": "sample.static_a"
      },
      "variables": {
        "address": "127.0.0.1",
        "ttl": 30
      }
    },
    {
      "name": "cache_plugin",
      "module": "cache_plugin",
      "enabled": true,
      "config": {
        "max_size": 100000
      },
      "variables": {}
    },
    {
      "name": "speedtest_plugin",
      "module": "speedtest_plugin",
      "enabled": true,
      "config": {
        "cache_ttl_seconds": 900,
        "cache_maxsize": 4096,
        "max_concurrency": 64,
        "probe_timeout": 1.5,
        "ping_count": 1,
        "ping_privileged": false,
        "response_ip_limit": 2,
        "response_ttl_seconds": 300,
        "skip_tags": [],
        "fallback_rules": []
      },
      "variables": {}
    },
    {
      "name": "block_plugin",
      "module": "block_plugin",
      "enabled": true,
      "config": {
        "rules": [
          {
            "match_tags": [
              "ads"
            ],
            "exclude_tags": [],
            "ipv4_addresses": [
              "127.0.0.1"
            ],
            "ipv6_addresses": [
              "::1"
            ],
            "response_ttl_seconds": 86400
          }
        ]
      },
      "variables": {}
    },
    {
      "name": "tag_plugin",
      "module": "tag_plugin",
      "enabled": true,
      "config": {},
      "variables": {}
    },
    {
      "name": "ip_replace_plugin",
      "module": "ip_replace_plugin",
      "enabled": true,
      "config": {
        "skip_tags": [
          "cn",
          "ads",
          "private"
        ],
        "rules": [
          {
            "name": "proxy-map",
            "match_tags": [
              "cloudflare"
            ],
            "exclude_tags": [],
            "ipv4_targets": [
              "162.159.44.0/32",
              "162.159.45.0/32"
            ],
            "ipv6_targets": [
              "2606:4700:52::/128",
              "2606:4700:57::/128"
            ]
          }
        ]
      },
      "variables": {}
    }
  ],
  "webui": {
    "enabled": true,
    "doh_enabled": true,
    "host": "127.0.0.1",
    "port": 8080,
    "username": "admin",
    "password": "admin"
  }
}